   "id": "8b142a48-4722-4bd3-96f2-4201b2039cae",
   "metadata": {},
   "outputs": [],
   "source": [
    "P = lambda a, N: 1 - sf.erf(a*np.sqrt(N / 2))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "63b802c5-a02d-435a-9553-ef88b9330a97",
   "metadata": {},
   "outputs": [],
   "source": [
    "sampling_a = 1000\n",
    "a0 = np.linspace(0,1,sampling_a)\n",
    "a = np.full((3,sampling_a), a0)\n",
    "N = np.array([1e2, 1e4, 1e6])\n",
    "P_out = P(a.T, N)"
   ]
  },
